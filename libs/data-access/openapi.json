{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "description": "The signed-in user's own password change (Story 2.6).\n\nThe new password's length is checked by the password policy in the service, so\nthe client gets the same `password_too_short` error as an admin reset.",
        "properties": {
          "current_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable error codes; the client shows `errors.<code>` from he.json.",
        "enum": [
          "recipe_not_found",
          "tag_not_found",
          "email_taken",
          "user_not_found",
          "password_too_short",
          "password_too_long",
          "invalid_credentials",
          "account_blocked",
          "last_admin",
          "rate_limited",
          "unauthorized",
          "forbidden",
          "csrf_header_missing"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "IngredientRead": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "original": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OriginalValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "unit",
          "note",
          "original",
          "source"
        ],
        "title": "IngredientRead",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Plain strings on purpose: a malformed email is just wrong credentials.",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OriginalValue": {
        "description": "The ingredient's amount and unit before its first edit (FR-7).\n\nBoth fields null means it was originally \"to taste\".",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "title": "OriginalValue",
        "type": "object"
      },
      "PhotoRead": {
        "description": "The photo shape that read schemas embed (AD-27); URLs are built server-side.",
        "properties": {
          "credit_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Domain"
          },
          "thumb_url": {
            "title": "Thumb Url",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "thumb_url",
          "credit_domain"
        ],
        "title": "PhotoRead",
        "type": "object"
      },
      "RecipeRead": {
        "properties": {
          "base_servings": {
            "title": "Base Servings",
            "type": "integer"
          },
          "cook_time_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cook Time Minutes"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRead"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "prep_time_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prep Time Minutes"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepRead"
            },
            "title": "Steps",
            "type": "array"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagRef"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "notes",
          "tags",
          "base_servings",
          "prep_time_minutes",
          "cook_time_minutes",
          "source_url",
          "photo",
          "ingredients",
          "steps",
          "created_at",
          "updated_at"
        ],
        "title": "RecipeRead",
        "type": "object"
      },
      "RecipeSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagRef"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "total_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Minutes"
          }
        },
        "required": [
          "id",
          "title",
          "tags",
          "total_minutes",
          "photo",
          "created_at"
        ],
        "title": "RecipeSummary",
        "type": "object"
      },
      "Role": {
        "description": "A visitor has no session, so there is no viewer role (AD-30).",
        "enum": [
          "editor",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionResponse": {
        "description": "`user` is null for a visitor.",
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionUser"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "user"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionUser": {
        "description": "What the client may know about the signed-in user (AD-21).",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "SourceUnit": {
        "description": "Imperial units an import converted to metric; kept as the 'source' value.",
        "enum": [
          "oz",
          "lb",
          "fl_oz"
        ],
        "title": "SourceUnit",
        "type": "string"
      },
      "SourceValue": {
        "description": "An imperial value an import converted to metric (FR-21).",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "unit": {
            "$ref": "#/components/schemas/SourceUnit"
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "title": "SourceValue",
        "type": "object"
      },
      "StepRead": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          }
        },
        "required": [
          "id",
          "description",
          "source_text"
        ],
        "title": "StepRead",
        "type": "object"
      },
      "TagRead": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pinned": {
            "title": "Pinned",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "pinned"
        ],
        "title": "TagRead",
        "type": "object"
      },
      "TagRef": {
        "description": "A tag as embedded in recipe read schemas (AD-20).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "TagRef",
        "type": "object"
      },
      "Unit": {
        "enum": [
          "g",
          "kg",
          "ml",
          "l",
          "tsp",
          "tbsp",
          "cup",
          "unit",
          "pinch",
          "clove",
          "slice",
          "can",
          "package"
        ],
        "title": "Unit",
        "type": "string"
      },
      "UserCreateRequest": {
        "description": "The body of `POST /api/users`: an account plus its starting password.\n\nThe confirmation field of the form is checked in the browser only; the server\njust enforces the password policy (FR-13).",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "name",
          "role",
          "password"
        ],
        "title": "UserCreateRequest",
        "type": "object"
      },
      "UserRead": {
        "description": "A user as returned to callers. There is deliberately no password field.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_blocked": {
            "title": "Is Blocked",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "is_blocked",
          "created_at"
        ],
        "title": "UserRead",
        "type": "object"
      },
      "UserUpdate": {
        "additionalProperties": false,
        "description": "The body of `PATCH /api/users/{id}`: any of these, at least one.\n\nA field that is left out stays as it is. `password` is a reset: it replaces the\ncurrent one and ends every session the user has.",
        "properties": {
          "is_blocked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Blocked"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bite & Board Recipe Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Always succeeds, signed in or not.",
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/password": {
      "post": {
        "description": "Change my own password (FR-27); any signed-in user, editor or admin.\n\nThe old cookie dies with the version bump, so the answer sets a new one: this\ndevice stays signed in and every other device is signed out.",
        "operationId": "auth_change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "description": "Public: 200 with the user, or `user: null` for a visitor (AD-21).",
        "operationId": "auth_session",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/recipes": {
      "get": {
        "operationId": "recipes_list_recipes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummary"
                  },
                  "title": "Response Recipes List Recipes",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Recipes",
        "tags": [
          "recipes"
        ]
      }
    },
    "/api/recipes/{recipe_id}": {
      "get": {
        "operationId": "recipes_get_recipe",
        "parameters": [
          {
            "in": "path",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recipe Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Recipe",
        "tags": [
          "recipes"
        ]
      }
    },
    "/api/tags": {
      "get": {
        "operationId": "tags_list_tags",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TagRead"
                  },
                  "title": "Response Tags List Tags",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Tags",
        "tags": [
          "tags"
        ]
      }
    },
    "/api/users": {
      "get": {
        "operationId": "users_list_users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserRead"
                  },
                  "title": "Response Users List Users",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "operationId": "users_create_user",
        "requestBody": {
          "content": {
