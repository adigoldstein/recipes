{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Stable error codes; the client shows `errors.<code>` from he.json.",
        "enum": [
          "recipe_not_found"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Params"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "IngredientRead": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "original": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OriginalValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "amount",
          "unit",
          "note",
          "original",
          "source"
        ],
        "title": "IngredientRead",
        "type": "object"
      },
      "OriginalValue": {
        "description": "The ingredient's amount and unit before its first edit (FR-7).\n\nBoth fields null means it was originally \"to taste\".",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Unit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "title": "OriginalValue",
        "type": "object"
      },
      "PhotoRead": {
        "description": "The photo shape that read schemas embed (AD-27); URLs are built server-side.",
        "properties": {
          "credit_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Domain"
          },
          "thumb_url": {
            "title": "Thumb Url",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "thumb_url",
          "credit_domain"
        ],
        "title": "PhotoRead",
        "type": "object"
      },
      "RecipeRead": {
        "properties": {
          "base_servings": {
            "title": "Base Servings",
            "type": "integer"
          },
          "cook_time_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cook Time Minutes"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRead"
            },
            "title": "Ingredients",
            "type": "array"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "prep_time_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prep Time Minutes"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepRead"
            },
            "title": "Steps",
            "type": "array"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagRef"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "notes",
          "tags",
          "base_servings",
          "prep_time_minutes",
          "cook_time_minutes",
          "source_url",
          "photo",
          "ingredients",
          "steps",
          "created_at",
          "updated_at"
        ],
        "title": "RecipeRead",
        "type": "object"
      },
      "RecipeSummary": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "photo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PhotoRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagRef"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "total_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Minutes"
          }
        },
        "required": [
          "id",
          "title",
          "tags",
          "total_minutes",
          "photo",
          "created_at"
        ],
        "title": "RecipeSummary",
        "type": "object"
      },
      "SourceUnit": {
        "description": "Imperial units an import converted to metric; kept as the 'source' value.",
        "enum": [
          "oz",
          "lb",
          "fl_oz"
        ],
        "title": "SourceUnit",
        "type": "string"
      },
      "SourceValue": {
        "description": "An imperial value an import converted to metric (FR-21).",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "unit": {
            "$ref": "#/components/schemas/SourceUnit"
          }
        },
        "required": [
          "amount",
          "unit"
        ],
        "title": "SourceValue",
        "type": "object"
      },
      "StepRead": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "source_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Text"
          }
        },
        "required": [
          "id",
          "description",
          "source_text"
        ],
        "title": "StepRead",
        "type": "object"
      },
      "TagRef": {
        "description": "A tag as embedded in recipe read schemas (AD-20).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "TagRef",
        "type": "object"
      },
      "Unit": {
        "enum": [
          "g",
          "kg",
          "ml",
          "l",
          "tsp",
          "tbsp",
          "cup",
          "unit",
          "pinch",
          "clove",
          "slice",
          "can",
          "package"
        ],
        "title": "Unit",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bite & Board Recipe Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/recipes": {
      "get": {
        "operationId": "recipes_list_recipes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummary"
                  },
                  "title": "Response Recipes List Recipes",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Recipes",
        "tags": [
          "recipes"
        ]
      }
    },
    "/api/recipes/{recipe_id}": {
      "get": {
        "operationId": "recipes_get_recipe",
        "parameters": [
          {
            "in": "path",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Recipe Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Recipe",
        "tags": [
          "recipes"
        ]
      }
    }
  }
}
