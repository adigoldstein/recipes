{
  "name": "@bite-and-board/data-access",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "data-access",
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "recipe-service:openapi"
        ],
        "inputs": [
          "{projectRoot}/openapi.json",
          "{projectRoot}/openapi-ts.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "options": {
          "command": "openapi-ts",
          "cwd": "{projectRoot}"
        },
        "cache": true
      }
    },
    "tags": [
      "type:data-access"
    ]
  }
}
