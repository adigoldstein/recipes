{
  "name": "@bite-and-board/ui-components",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./theme.css": "./src/styles/theme.css"
  },
  "imports": {
    "#components/ui/*": "./src/components/ui/*.tsx",
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "nx": {
    "name": "ui-components",
    "tags": [
      "type:ui"
    ]
  }
}
