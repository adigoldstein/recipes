# Copy to .env (gitignored) for local development. In production, set these as
# real environment variables on the container instead of using a file.

# dev | production. Defaults to production when unset (the safe choice).
ENV=dev

# Folder for the SQLite database and uploaded photos (a mounted volume in production).
DATA_DIR=./data

# Required. Signs session cookies; the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Send the session cookie only over HTTPS. false is allowed only when ENV=dev
# (for testing from a phone over the LAN).
COOKIE_SECURE=true

# The import engine: anthropic (Claude Haiku, the default), gemini, or fake (tests/CI only).
# The first name is the one used; there is no automatic fallback. To switch engines,
# change this one line (and set that engine's API key below).
LLM_PROVIDERS=anthropic

# Gemini free tier, an option (LLM_PROVIDERS=gemini). Without a key the engine is unavailable and imports return an error.
# The model name is configuration, because Google retires names (Story 5.1 spike).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Claude API (Haiku 5.5), the default engine. Key from the Claude Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=30

# Imports allowed per day across all users, the token cap per LLM call,
# and the longest pasted text an import accepts (characters).
IMPORT_DAILY_CAP=50
LLM_MAX_TOKENS=4096
IMPORT_MAX_CHARS=20000

# URL imports: the largest page in bytes (3 MB) and the longest fetch in seconds,
# redirects included. With LLM_PROVIDERS=fake, pages come from fake://<fixture>.
PAGE_MAX_BYTES=3145728
PAGE_FETCH_TIMEOUT_SECONDS=15

# The daily import cap resets at midnight in this timezone.
APP_TIMEZONE=Asia/Jerusalem

# Photo uploads: the largest file in bytes (10 MB) and the largest picture in pixels.
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_PIXELS=40000000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
