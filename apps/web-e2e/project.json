{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["web", "recipe-service"],
  "tags": ["type:e2e"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["web:build"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "playwright test --trace off"
      }
    }
  }
}
