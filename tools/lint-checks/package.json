{
  "name": "@bite-and-board/lint-checks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "lint-checks",
    "tags": [
      "type:tooling"
    ],
    "implicitDependencies": [
      "web",
      "ui-components",
      "data-access",
      "recipe-domain",
      "i18n",
      "recipe-service"
    ],
    "targets": {
      "test": {
        "dependsOn": [],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/eslint.config.mjs",
          {
            "externalDependencies": [
              "eslint",
              "@nx/eslint-plugin",
              "eslint-plugin-better-tailwindcss",
              "eslint-plugin-jsx-a11y",
              "eslint-plugin-react",
              "eslint-plugin-react-hooks",
              "vite",
              "@vitejs/plugin-react",
              "@rolldown/plugin-babel",
              "babel-plugin-react-compiler"
            ]
          }
        ]
      }
    }
  }
}
